{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "audio-player",
  "version": "0.1.3",
  "identifier": "com.lumen.audio-player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Lumen Audio Player",
        "width": 1400,
        "height": 840,
        "minWidth": 771,
        "minHeight": 464,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost ipc: http://ipc.localhost https://www.yangandxu.asia",
        "script-src": "'self'",
        "img-src": "'self' blob: data:",
        "style-src": "'unsafe-inline' 'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*"
        ]
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
