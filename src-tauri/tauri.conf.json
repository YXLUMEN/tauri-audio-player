{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen-Audio-Player",
  "version": "0.1.28",
  "identifier": "com.lumen.audio-player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "Lumen Audio Player",
        "width": 1208,
        "height": 752,
        "minWidth": 771,
        "minHeight": 752,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset: http://asset.localhost ipc: http://ipc.localhost https://arctic-red-tide.xyz",
        "script-src": "'self'",
        "img-src": "'self' blob: data:",
        "style-src": "'unsafe-inline' 'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*"
        ]
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "createUpdaterArtifacts": true,
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "basicUi"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwOTk3REM0RjQwOTFEMEMKUldRTUhRbjB4SDJaY0NDMGVpT1N0YlN6V3BhbVVqU3BNZ0ZGblBjMkpjQ0dDWnZXS2s0WVhmdFYK",
      "endpoints": [
        "https://arctic-red-tide.xyz/app/lumen-player/latest.json"
      ]
    }
  }
}
